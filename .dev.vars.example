# 秘密情報のひな形です。ここには値を書かないでください。
# 手元で動かすとき（npm run dev）は、このファイルを .dev.vars という名前で写して値を入れます（.dev.vars は git に入れません）。
# Cloudflare の Deploy ボタンで置くときは、ここに書いた項目が入力欄になります。
# あとから変えるときは、Cloudflare のダッシュボード（Workers & Pages → このアプリ → Settings → Variables and Secrets）で変えます。

# 合言葉（10字以上・256字以内）。前後の空白・改行は無視します。未設定・10字未満・256字超なら門は閉じたままです
GATE_PASSWORD=
# Gemini API キー（聞き取りと読み上げ）。請求先をつなぎ、1か月の費用の上限を掛けてから作ります
GEMINI_API_KEY=
# Anthropic API キー（採点）。このアプリ専用のワークスペースを作り、支出上限（月）を入れてから、そのワークスペースで作ります
ANTHROPIC_API_KEY=

# 任意：cookie の署名の鍵（32字以上の乱数）。決めなければ合言葉から作ります。入力欄にしないため、行の頭を # にしています
# COOKIE_SECRET=

# 任意（お試しモードのときだけ）：管理用の参加者の一覧（/trial/admin）を開くための合言葉（32字以上の乱数）。入力欄にしないため、行の頭を # にしています
# TRIAL_ADMIN_TOKEN=
