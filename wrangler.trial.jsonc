{
  "$schema": "node_modules/wrangler/config-schema.json",
  // お試しモード用（複数人で試すとき）。wrangler.jsonc と同じで、name・dev・vars だけが違う（違いは tests/config.test.ts が確かめる）。
  // npm run deploy:trial で出す。TRIAL_ENDS_ON は終了日（その日を含む）。日程を変えるときはここも直す。
  "name": "speak25-trial",
  "main": "src/server/worker.ts",
  // wrangler 4.124.0 の workerd（1.20260815.1）が扱える最新の日付。wrangler を上げるときに一緒に見直す
  "compatibility_date": "2026-08-15",
  // nodejs_compat は Anthropic SDK のため。2つ目は process.env に secret を入れないため（受け付けられなければ外す）
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // すべての要求をまず Worker（src/server/app.ts）に通す。門の外は src/server/gate/policy.ts の gateExempt だけ
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "durable_objects": { "bindings": [ { "name": "PRACTICE", "class_name": "PracticeDO" } ] },
  // DO のクラスの移行（SQL のマイグレーションとは別）。v1 は一度出したら書き換えない
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["PracticeDO"] } ],
  "dev": { "port": 8821, "inspector_port": 9821 },
  // 1日の上限（全員の合計）・頻度制限・お試しの設定。値は文字列で、数字だけを受ける（範囲を外れたら既定に戻る）。
  // 秘密（合言葉・キー・管理用の合言葉）は vars に書かず、Secret に登録する。vars は deploy のたびにこのファイルの値で置き換わる
  "vars": {
    "DAILY_ANSWER_LIMIT": "1000",
    "DAILY_YEN_LIMIT": "150",
    "DAILY_SPEECH_LIMIT": "80",
    "RATE_ANSWER_PER_MINUTE": "40",
    "RATE_SPEECH_PER_MINUTE": "30",
    "TRIAL_MODE": "1",
    "TRIAL_QUESTIONS_PER_DAY": "100",
    "TRIAL_SPEECH_PER_DAY": "10",
    "TRIAL_ENDS_ON": "2026-11-01"
  },
  "observability": { "enabled": true }
}
